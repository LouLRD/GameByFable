  "statements": [
    {"id": "s_ana_initial", "speakerId": "ana", "propositionId": "prop_ana_no_unusual_drawer", "relationToBelief": "lie", "unlockConditionIds": [], "availableAtStart": true, "publicText": "Je n'ai rien fait d'inhabituel avec la caisse après 20 h 40. Je préparais simplement la fermeture."},
    {"id": "s_malik_initial", "speakerId": "malik", "propositionId": "prop_sleeve_left_office", "relationToBelief": "lie", "unlockConditionIds": [], "availableAtStart": true, "publicText": "Ana m'a donné une pochette. Je l'ai posée directement sur son bureau, comme toujours."},
    {"id": "s_ines_initial", "speakerId": "ines", "propositionId": "prop_ines_cold_aisle_continuous", "relationToBelief": "lie", "unlockConditionIds": [], "availableAtStart": true, "publicText": "Je suis restée dans l'allée froide tout le temps. Je n'ai touché ni aux caméras ni au bureau."},
    {"id": "s_jo_initial", "speakerId": "jo", "propositionId": "prop_pallet_arrived_2102", "relationToBelief": "lie", "unlockConditionIds": [], "availableAtStart": true, "publicText": "La palette n'est entrée qu'après 21 h 02. Elle ne pouvait rien masquer pendant la coupure."},
    {"id": "s_mina_initial", "speakerId": "mina", "propositionId": "prop_mina_saw_no_paperwork", "relationToBelief": "lie", "unlockConditionIds": [], "availableAtStart": true, "publicText": "J'ai poussé le chariot vers la réserve. Il n'y avait rien dessus qui ressemblait à de l'argent ou à un document."},
    {"id": "s_noe_initial", "speakerId": "noe", "propositionId": "prop_ines_went_stockroom", "relationToBelief": "embellished", "unlockConditionIds": [], "availableAtStart": true, "publicText": "J'ai entendu la porte de la réserve claquer et j'ai vu Inès y entrer juste après."},
    {"id": "s_malik_clarified", "speakerId": "malik", "propositionId": "prop_sleeve_left_trolley", "relationToBelief": "honest", "unlockConditionIds": ["c_malik_route"], "availableAtStart": false, "publicText": "Je l'ai posée sur le chariot quand la bouteille a cassé. Je comptais la reprendre. Je croyais qu'il y avait les 300 € dedans."},
    {"id": "s_ines_clarified", "speakerId": "ines", "propositionId": "prop_kettle_caused_trip", "relationToBelief": "honest", "unlockConditionIds": ["c_ines_camera"], "availableAtStart": false, "publicText": "J'ai lancé la bouilloire. Les néons ont baissé et l'enregistreur s'est éteint. J'ai paniqué, mais je n'ai rien débranché."},
